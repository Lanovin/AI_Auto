# ────────────────────────────────────────────────────────────────────────────
# Anthropic (AI oceňování)
# ────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Volitelně: přepsání modelů. Výchozí: Sonnet 5 pro rychlý–detailní tier,
# Opus 5 pro expertní posudek, Haiku 4.5 pro levný monitoring bez web search.
# ANTHROPIC_SCAN_MODEL=claude-sonnet-5
# ANTHROPIC_EXPERT_MODEL=claude-opus-5
# ANTHROPIC_MONITOR_MODEL=claude-haiku-4-5
# Model pomocníka Davida v chatu (rychlý a levný, běží na stejném klíči).
# ANTHROPIC_CHAT_MODEL=claude-haiku-4-5

# Neon Postgres – pooled connection string (sdílená cache skenů + price_stats)
# https://console.neon.tech/ → projekt → Connection string (pooled)
# Po vytvoření spusťte neon/migrations/*.sql. Bez DATABASE_URL web běží, ale
# každé ocenění platí plnou cenu AI (žádná cache) a do logu padají chyby.
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ────────────────────────────────────────────────────────────────────────────
# Supabase (auth + uživatelská data + tokeny)
# ────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Nebo (fallback) klasický anon key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service-role key — POUZE SERVER, v produkci POVINNÝ. Používá ho Stripe webhook
# (připsání tokenů), refund tokenů při selhání skenu, propojení účtu se Stripe
# zákazníkem, admin CMS a promo kódy. Bez něj se zaplacené tokeny nepřipíší.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Google přihlášení: Supabase Dashboard → Authentication → Providers → Google
# (Client ID + Secret z Google Cloud Console; Authorized redirect URI =
# https://YOUR_PROJECT.supabase.co/auth/v1/callback). Pak Authentication →
# URL Configuration → Redirect URLs přidat https://<doména>/auth/callback
# a http://localhost:3000/auth/callback.

# ────────────────────────────────────────────────────────────────────────────
# Stripe (balíčky tokenů + volitelné měsíční předplatné)
# ────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook secret pro /api/stripe/webhook
#   lokálně: stripe listen --forward-to localhost:3000/api/stripe/webhook
#   produkce: Stripe Dashboard → Developers → Webhooks → endpoint
#   https://<doména>/api/stripe/webhook, události: checkout.session.completed,
#   invoice.payment_succeeded, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs jednorázových balíčků (Stripe → Products, mode: one-time, CZK):
#   • 500 Kč → 90 tokenů, 1 000 Kč → 200, 2 000 Kč → 440, 5 000 Kč → 1 200
STRIPE_PRICE_BALICEK_500=price_...
STRIPE_PRICE_BALICEK_1000=price_...
STRIPE_PRICE_BALICEK_2000=price_...
STRIPE_PRICE_BALICEK_5000=price_...
# Volitelné měsíční předplatné (recurring price, 1 490 Kč/měs → 360 tokenů/měs).
# Když není nastavené, sekce předplatného se v ceníku nezobrazí.
# STRIPE_PRICE_PREDPLATNE=price_...

# Veřejná URL aplikace (Stripe redirecty, sitemap). Když chybí, odvodí se z requestu.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ────────────────────────────────────────────────────────────────────────────
# Kontaktní formulář — Resend (https://resend.com)
# ────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
CONTACT_TO_EMAIL=ytlaso2@gmail.com
# Odesílatel musí být na doméně ověřené v Resend. Bez vlastní domény jde použít
# "Cargent <onboarding@resend.dev>" (doručí jen na e-mail vlastníka Resend účtu).
CONTACT_FROM_EMAIL=Cargent <onboarding@resend.dev>

# ────────────────────────────────────────────────────────────────────────────
# Limity
# ────────────────────────────────────────────────────────────────────────────
# Denní limit AI ocenění na přihlášeného uživatele (klouzavé okno 24 h). 0 = vypnuto.
DAILY_SCAN_LIMIT=30

# ────────────────────────────────────────────────────────────────────────────
# Admin CMS (/admin) — texty, ceník tokenů, promo kódy, neúčtované skeny
# ────────────────────────────────────────────────────────────────────────────
# V PRODUKCI musí mít ADMIN_PASSWORD aspoň 10 znaků a nesmí být „admin“,
# „password“, „change-me“ apod. — jinak je přihlášení do administrace vypnuté.
# Přihlášení: /prihlaseni, do pole e-mail zadejte uživatelské jméno (bez @).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Volitelné: náhodný řetězec (např. `openssl rand -hex 32`) pro podpis admin cookie.
# Když chybí, odvodí se z jména a hesla (změna hesla odhlásí všechny adminy).
ADMIN_SESSION_SECRET=
