# Anthropic API klíč
# Získejte na: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Neon Postgres – pooled connection string (sdílený cache skenů)
# Získejte na: https://console.neon.tech/ → projekt → Connection string (pooled)
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ────────────────────────────────────────────────────────────────────────────
# Supabase (auth + uživatelská data + tokeny)
# ────────────────────────────────────────────────────────────────────────────
# Veřejné — bezpečné na klientovi
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Nebo (fallback) klasický anon key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service-role key — POUZE SERVER. NIKDY nezveřejňovat v klientovi.
# Používá se Stripe webhookem k udělování tokenů (bypassuje RLS).
# Najdete v Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ────────────────────────────────────────────────────────────────────────────
# Stripe (předplatné + tokeny)
# ────────────────────────────────────────────────────────────────────────────
# 1) Klíče najdete na: https://dashboard.stripe.com/test/apikeys
#    V test módu používá sk_test_... a pk_test_...
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# 2) Webhook secret pro ověření signatur na /api/stripe/webhook
#    Pro lokální vývoj: spusťte `stripe listen --forward-to localhost:3000/api/stripe/webhook`
#    Stripe CLI vám vypíše `whsec_...` — to použijte tady.
#    Pro produkci: vytvořte endpoint v Stripe Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# 3) Price IDs — vytvořte 3 produkty v Stripe Dashboard a vložte sem jejich Price IDs.
#
#    Doporučené nastavení v Dashboardu:
#      • Předplatné Autobazar:  10 CZK / měsíc, recurring → price_...
#      • Předplatné Monitoring: 20 CZK / měsíc, recurring → price_...
#      • Tokeny test:            0 CZK, one-time         → price_...
#
#    Pozn.: Stripe podporuje 0 Kč Price IDs (one-time). Pro produkční prodej
#    tokenů cenu jednoduše zvedněte v Dashboardu — kód zůstane stejný.
STRIPE_PRICE_DEALER=price_...
STRIPE_PRICE_MONITORING=price_...
STRIPE_PRICE_TOKENS_TEST=price_...

# 4) URL aplikace pro Stripe success/cancel redirecty
#    Lokálně: http://localhost:3000
#    Produkce: https://váš.domain.cz
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ────────────────────────────────────────────────────────────────────────────
# Limity
# ────────────────────────────────────────────────────────────────────────────
# Denní limit AI ocenění na přihlášeného uživatele (klouzavé okno 24 h).
# Právní pojistka proti hromadné extrakci dat z portálů — viz src/lib/rate-limit.ts.
# 0 = limit vypnut. Výchozí: 30.
DAILY_SCAN_LIMIT=30

# ────────────────────────────────────────────────────────────────────────────
# Admin CMS (/admin) — úprava textů a správa promo kódů
# ────────────────────────────────────────────────────────────────────────────
# Přihlašovací údaje do /admin. Pokud je nevyplníte, použije se admin / admin.
# V produkci NASTAVTE vlastní heslo!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Nepovinné: vlastní tajný klíč pro podpis přihlašovací cookie. Když ho
# nevyplníte, odvodí se z údajů výše (změna hesla zneplatní staré přihlášení).
ADMIN_SESSION_SECRET=
#
# Pozn.: Admin CMS i promo kódy zapisují do Supabase přes service-role klíč
# (SUPABASE_SERVICE_ROLE_KEY výše). Bez něj jdou texty jen číst, ne ukládat.
# Před použitím spusťte migraci supabase/migrations/0004_admin_cms.sql.
